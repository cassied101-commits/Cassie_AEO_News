# ── Required ──────────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Scheduler ─────────────────────────────────────────────────────────────
# Set RUN_SCHEDULER=true to auto-generate the brief daily when running app.py
RUN_SCHEDULER=true

# What time (24h) to run the daily brief — defaults to 07:00 UTC
BRIEF_HOUR=7
BRIEF_MINUTE=0

# Timezone for the scheduler (any IANA tz string, e.g. America/New_York)
BRIEF_TIMEZONE=UTC

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
